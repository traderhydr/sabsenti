# Telegram (leave empty to run in dry-run mode: signals print to console)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# X (Twitter) API v2 bearer token (optional; paid tier needed for search).
# Without it the bot uses CoinGecko trending, Fear & Greed, news RSS and Reddit.
X_BEARER_TOKEN=
# Extra accounts whose recent posts are scanned (comma-separated, no @)
X_ACCOUNTS=

# CryptoPanic free API key (cryptopanic.com/developers/api) - news with community votes
CRYPTOPANIC_TOKEN=
# Skip LONG if funding > this %, skip SHORT if funding < -this % (crowded trade)
FUNDING_MAX_PCT=0.05

SCAN_SECONDS=300
TOP_N=40                 # Binance USDT perps by 24h volume considered
MIN_QUOTE_VOLUME_USD=50000000
MIN_SENTIMENT=0.25       # |score| needed (range -1..1)
MIN_MENTIONS=3           # buzz threshold across all sources
LEVERAGE=5
ATR_SL_MULT=1.5
TP_MULTIPLES=1.0,1.8,2.6
COOLDOWN_HOURS=12
MAX_SIGNALS_PER_SCAN=2
